# Production URL used for canonical links, Open Graph, robots.txt and sitemap.xml.
# On Vercel this can be left empty if System Environment Variables are exposed;
# the app falls back to VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL.
NEXT_PUBLIC_SITE_URL=https://www.example.co.uk

# Contact form delivery. Use Resend for automatic server-side email delivery.
# If this is left empty or delivery fails, the form opens a prefilled email draft
# addressed to the public company email so the enquiry is not lost.
CONTACT_PROVIDER=

# CONTACT_PROVIDER=resend
CONTACT_TO=edwinswanith006@gmail.com
CONTACT_FROM="Tech Cogniverse <hello@techcogniverse.co.uk>"
RESEND_API_KEY=

# CONTACT_PROVIDER=webhook
CONTACT_WEBHOOK_URL=
