# Contact form delivery. Leave CONTACT_PROVIDER empty until a provider is chosen:
# the form then tells visitors it cannot deliver and shows direct contact details.
CONTACT_PROVIDER=          # "resend" | "webhook"
CONTACT_TO=                # destination address (resend)
CONTACT_FROM=              # verified sender (resend)
RESEND_API_KEY=
CONTACT_WEBHOOK_URL=       # (webhook) receives JSON POST
